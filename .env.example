# BLACKMAMERSTUDIO — local development example
# Set these values in Vercel > Project > Settings > Environment Variables for production.
PORT=3000
BASE_URL=http://localhost:3000

# Generate independent, random long secrets before production.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
KEY_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

# /admin → admin login. Configure ADMIN_PASSWORD on Vercel to enable it.
ADMIN_USERNAME=blackmamer
ADMIN_PASSWORD=

# Optional Discord OAuth (own username/password login works without Discord).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord
ALLOW_DEV_LOGIN=0

# Optional remote persistence, needed for durable user accounts on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BIND_IP=0
