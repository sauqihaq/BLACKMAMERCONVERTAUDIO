{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{public/**,bin/**}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin-login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
