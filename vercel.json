{
  "version": 2,
  "functions": {
    "server.js": { "maxDuration": 300, "memory": 1024, "includeFiles": "public/**" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}
